{
  "version": 2,
  "stack": "nextjs",
  "mode": "brownfield",
  "projectId": "nextjs",
  "commands": {
    "genDry": ["codegenkit", "gen:dry", "--adapter=nextjs", "--project-root=.", "--", "--id", "{spec}"],
    "gen": ["codegenkit", "gen", "--adapter=nextjs", "--project-root=.", "--", "--id", "{spec}"],
    "unitGenDry": ["codegenkit", "unit-gen:dry", "--adapter=nextjs", "--project-root=.", "--", "--spec", "{spec}"],
    "unitGen": ["codegenkit", "unit-gen", "--adapter=nextjs", "--project-root=.", "--", "--spec", "{spec}"],
    "testcaseGenDry": ["testkit", "testcase:gen:dry", "--project-root=.", "--", "--id", "{spec}"],
    "testcaseGen": ["testkit", "testcase:gen", "--project-root=.", "--", "--id", "{spec}"],
    "registryValidate": ["codegenkit", "registry", "--adapter=nextjs", "--project-root=."],
    "unitRegistry": ["codegenkit", "unit-registry", "--adapter=nextjs", "--project-root=."],
    "e2eRegistry": ["testkit", "e2e-registry", "--project-root=."]
  },
  "registries": [
    "registries/design.registry.json",
    "registries/unit-test.registry.json",
    "registries/e2e-test.registry.json",
    "registries/contract-field.registry.json"
  ],
  "gapSources": [
    "**/generated/HANDOFF.md",
    "**/generated/UNIT-HANDOFF.md",
    "**/generated/codegen.manifest.json"
  ],
  "specRoots": []
}
